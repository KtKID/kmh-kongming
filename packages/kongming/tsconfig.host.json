{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "lib",
    "declaration": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023"],
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@deepseek-ai/cordis": [
        "./node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-agent": [
        "./node_modules/@deepseek-ai/dsh-agent/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-llm": [
        "./node_modules/@deepseek-ai/dsh-llm/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-session": [
        "./node_modules/@deepseek-ai/dsh-session/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-session/types": [
        "./node_modules/@deepseek-ai/dsh-session/lib/types/types.d.ts"
      ],
      "@deepseek-ai/dsh-api-session-controller": [
        "./node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-workspace": [
        "./node_modules/@deepseek-ai/dsh-workspace/lib/types/index.d.ts"
      ]
    },
    "composite": true,
    "tsBuildInfoFile": "lib/host.tsbuildinfo",
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/client", "src/dispatch/client", "src/session/client"]
}
